# Clé API Mistral AI (Obligatoire)
# Obtenez votre clé sur https://console.mistral.ai/
MISTRAL_API_KEY=

# Modèle Mistral par défaut (Optionnel - valeur par défaut: mistral-large-2512)
MISTRAL_MODEL=mistral-large-2512
